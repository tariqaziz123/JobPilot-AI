// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id @default(cuid())
  name       String?
  email      String   @unique
  password   String?
  skills     String[]
  resumeText String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs                  Job[]
  applications          Application[]
  coverLetters          CoverLetter[]
  aiAnalyses            AIAnalysis[]
  resumeAnalyses        ResumeAnalysis[]
  interviewPreparations InterviewPreparation[]
  interviewSessions     InterviewSession[]
}

model Job {
  id     String @id @default(cuid())
  userId String

  company     String
  title       String
  location    String?
  jobUrl      String?
  description String?
  salary      String?
  source      String?

  status String @default("SAVED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications          Application[]
  aiAnalyses            AIAnalysis[]
  coverLetters          CoverLetter[]
  interviewPreparations InterviewPreparation[]
  interviewSessions     InterviewSession[]

  @@index([userId])
}

model Application {
  id     String @id @default(cuid())
  userId String
  jobId  String

  status    String   @default("APPLIED")
  appliedAt DateTime @default(now())
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jobId])
}

model AIAnalysis {
  id     String @id @default(cuid())
  userId String
  jobId  String

  matchScore     Int?
  atsScore       Int?
  skillsMatched  String[] @default([])
  missingSkills  String[] @default([])
  recommendation String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jobId])
}

model ResumeAnalysis {
  id     String @id @default(cuid())
  userId String

  resumeScore       Int?
  atsScore          Int?
  strengths         Json?
  weaknesses        Json?
  missingKeywords   Json?
  improvements      Json?
  recommendedSkills Json?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CoverLetter {
  id     String @id @default(cuid())
  userId String
  jobId  String

  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jobId])
}

model InterviewPreparation {
  id               String   @id @default(cuid())
  userId           String
  jobId            String
  questions        Json
  preparationTips  Json
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jobId])
  @@index([createdAt])
}

model InterviewSession {
  id              String   @id @default(cuid())
  userId          String
  jobId           String
  status          String   @default("IN_PROGRESS")
  currentQuestion Int      @default(0)
  totalQuestions  Int      @default(10)
  finalScore      Int?
  startedAt       DateTime @default(now())
  completedAt     DateTime?

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  job     Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  answers InterviewAnswer[]

  @@index([userId])
  @@index([jobId])
}

model InterviewAnswer {
  id             String   @id @default(cuid())
  sessionId      String
  questionIndex  Int
  question       String
  candidateAnswer String
  score          Int?
  strengths      Json?
  weaknesses     Json?
  feedback       String?
  improvedAnswer String?
  createdAt      DateTime @default(now())

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}
